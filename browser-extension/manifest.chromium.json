{
  "manifest_version": 3,
  "name": "PwVault 自動入力",
  "version": "0.2.0",
  "description": "入力欄の右クリックメニューから、PwVault に保存したユーザーIDとパスワードを入力します。",
  "key": "",
  "permissions": ["contextMenus", "nativeMessaging", "scripting", "activeTab", "tabs"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
