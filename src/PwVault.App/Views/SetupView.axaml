<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PwVault.App.ViewModels"
             x:Class="PwVault.App.Views.SetupView"
             x:DataType="vm:SetupViewModel">
    <ScrollViewer>
        <Border Classes="card" Width="560" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="16">
                <StackPanel Spacing="4">
                    <TextBlock Classes="h1" Text="保管庫を作成" />
                    <TextBlock Classes="muted" Text="パスワードは暗号化してこの PC 上の 1 つのファイルに保存します。通信は一切行いません。" />
                </StackPanel>

                <!-- 2 台目の PC: 同期フォルダに既にある保管庫を開く -->
                <Border Background="{DynamicResource PaneBackground}" CornerRadius="6" Padding="14" IsVisible="{Binding HasCloudVaults}">
                    <StackPanel Spacing="8">
                        <TextBlock FontWeight="SemiBold" Text="ほかの PC で作った保管庫が見つかりました" />
                        <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap"
                                   Text="同じ保管庫を使う場合は、新しく作らずにこちらを開いてください。" />
                        <ItemsControl ItemsSource="{Binding CloudVaults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CloudVault">
                                    <StackPanel Margin="0,4,0,0" Spacing="2">
                                        <Button Classes="accent" Content="{Binding Label}"
                                                Command="{Binding $parent[ItemsControl].((vm:SetupViewModel)DataContext).OpenCloudVaultCommand}"
                                                CommandParameter="{Binding}" />
                                        <TextBlock Classes="muted" FontSize="12" Text="{Binding Path}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <StackPanel>
                    <TextBlock Classes="label" Text="保存先" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Text="{Binding VaultPath}" />
                        <Button Grid.Column="1" Content="参照…" Command="{Binding BrowseCommand}" />
                    </Grid>
                </StackPanel>

                <StackPanel>
                    <TextBlock Classes="label" Text="マスターパスワード（12 文字以上）" />
                    <TextBox x:Name="PasswordBox" PasswordChar="●" Text="{Binding Password}" />
                    <ProgressBar Classes="strength" Margin="0,6,0,0" Value="{Binding StrengthValue}" />
                    <TextBlock Classes="muted" FontSize="12" Margin="0,4,0,0" Text="{Binding StrengthText}" />
                    <TextBlock Classes="error" FontSize="12" IsVisible="{Binding IsTooShort}"
                               Text="マスターパスワードは 12 文字以上にしてください。" />
                </StackPanel>

                <StackPanel>
                    <TextBlock Classes="label" Text="マスターパスワード（確認）" />
                    <TextBox PasswordChar="●" Text="{Binding ConfirmPassword}" />
                </StackPanel>

                <Border Background="{DynamicResource PaneBackground}" CornerRadius="6" Padding="14">
                    <StackPanel Spacing="8">
                        <TextBlock FontWeight="SemiBold" Text="緊急キットについて" />
                        <TextBlock Classes="muted" FontSize="13"
                                   Text="マスターパスワードはどこにも保存されず、忘れると保管庫は二度と開けません（復旧手段はありません）。紙に書いて、保管庫の場所と一緒に安全な場所に保管してください。" />
                        <Button Content="緊急キット（記入用テキスト）を保存…" Command="{Binding SaveEmergencyKitCommand}" />
                        <CheckBox IsChecked="{Binding Acknowledged}"
                                  Content="マスターパスワードを忘れると復旧できないことを理解しました" />
                    </StackPanel>
                </Border>

                <TextBlock Classes="error" Text="{Binding Error}"
                           IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <Grid ColumnDefinitions="*,Auto">
                    <Button Content="既存の保管庫を開く…" Command="{Binding OpenExistingCommand}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                        <TextBlock VerticalAlignment="Center" Classes="muted" IsVisible="{Binding IsBusy}"
                                   Text="この PC に合わせて暗号の強さを調整中…" />
                        <Button Classes="accent" Content="作成" IsDefault="True"
                                IsEnabled="{Binding !IsBusy}" Command="{Binding CreateCommand}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
