<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PwVault.App.ViewModels"
             xmlns:svc="using:PwVault.App.Services"
             xmlns:local="using:PwVault.App.Views"
             x:Class="PwVault.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <Grid ColumnDefinitions="220,*">
        <!-- カテゴリー -->
        <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,16">
                <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="4,0,4,12">
                    <TextBlock Classes="h1" Text="設定" />
                    <Button Content="← 一覧に戻る" HorizontalAlignment="Stretch" Command="{Binding BackCommand}" />
                </StackPanel>
                <ListBox local:Tour.Id="settings-categories" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SettingsCategoryItem">
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="2,4">
                                <TextBlock Text="{Binding Icon}" Width="20" TextAlignment="Center" />
                                <TextBlock Text="{Binding Label}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Column="1">
        <StackPanel Spacing="16" Margin="24" MaxWidth="720">
            <TextBlock Classes="h1" Text="{Binding SelectedCategory.Label}" />
            <TextBlock Classes="muted" FontSize="12" Text="{Binding VaultPath, StringFormat='保管庫: {0}'}" />

            <!-- 一般 -->
            <StackPanel Spacing="16" IsVisible="{Binding IsGeneral}">
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="h2" Text="一般" />
                        <Grid ColumnDefinitions="260,160" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                            <TextBlock VerticalAlignment="Center" Text="自動ロックまでの無操作時間（分）" />
                            <NumericUpDown Grid.Column="1" Minimum="1" Maximum="240" Increment="1" FormatString="0" Value="{Binding AutoLockMinutes}" />
                            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="クリップボードの保持時間（秒）" />
                            <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="5" Maximum="600" Increment="5" FormatString="0" Value="{Binding ClipboardSeconds}" />
                            <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="バックアップ（.bak）の世代数" />
                            <NumericUpDown Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="20" Increment="1" FormatString="0" Value="{Binding BackupGenerations}" />
                        </Grid>
                        <TextBlock Classes="muted" FontSize="12" Text="OS のロック・スリープ時は設定にかかわらず即座にロックします。" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Classes="accent" Content="保存" Command="{Binding SaveGeneralCommand}" />
                            <TextBlock Classes="success" VerticalAlignment="Center" Text="{Binding GeneralStatus}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="h2" Text="起動・終了と操作" />
                            <StackPanel IsVisible="{Binding AutoStartSupported}">
                                <CheckBox IsChecked="{Binding AutoStartEnabled}" Content="PC にサインインしたら自動で起動する" />
                                <TextBlock Classes="muted" FontSize="12" Margin="28,0,0,0"
                                           Text="ウィンドウは出さず、通知領域（Mac はメニューバー）に隠れた状態で起動します。ブラウザ拡張の「PwVault をアンロックする」や通知領域のアイコンから開けます。" />
                                <TextBlock Classes="success" FontSize="12" Margin="28,2,0,0" Text="{Binding AutoStartStatus}"
                                           IsVisible="{Binding AutoStartStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                            <CheckBox IsChecked="{Binding DoubleClickOpensUrl}" Content="一覧をダブルクリックしてサイトを開く" />
                            <StackPanel>
                                <CheckBox IsChecked="{Binding CloseToTray}" Content="×ボタンで閉じずに通知領域（Windows はタスクトレイ、Mac はメニューバー）に隠す" />
                                <TextBlock Classes="muted" FontSize="12" Margin="28,0,0,0"
                                           Text="隠れている間もブラウザ連携と自動ロックは動きます。終了するには通知領域のアイコンを右クリックして「終了」を選びます。" />
                            </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 表示 -->
            <StackPanel Spacing="16" IsVisible="{Binding IsDisplay}">
                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="h2" Text="テーマと色" />
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="10">
                                <TextBlock VerticalAlignment="Center" Text="テーマ" />
                                <ListBox Grid.Column="1" ItemsSource="{Binding ThemeModes}" SelectedItem="{Binding SelectedTheme}"
                                         Background="Transparent">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="svc:ThemeService+ThemeOption">
                                            <TextBlock Text="{Binding Label}" Margin="4,0" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Grid.Row="1" VerticalAlignment="Top" Margin="0,10,0,0" Text="色" />
                                <ListBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Accents}" SelectedItem="{Binding SelectedAccent}"
                                         Background="Transparent">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="svc:ThemeService+AccentOption">
                                            <StackPanel Orientation="Horizontal" Spacing="6" ToolTip.Tip="{Binding Label}">
                                                <Ellipse Width="16" Height="16" VerticalAlignment="Center">
                                                    <Ellipse.Fill>
                                                        <SolidColorBrush Color="{Binding Color}" />
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                            <TextBlock Classes="muted" FontSize="12"
                                       Text="一覧画面の右下の「🌙 ダーク / ☀ ライト」ボタンでも切り替えられます。「OS に合わせる」の色は Windows（Mac）のアクセントカラーです。" />
                    </StackPanel>
                </Border>
                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="h2" Text="サイトのアイコン" />
                            <StackPanel>
                                <CheckBox IsChecked="{Binding FetchSiteIcons}" Content="サイトのアイコンを各サイトから取得する" />
                                <TextBlock Classes="muted" FontSize="12" Margin="28,0,0,0"
                                           Text="ブラウザ連携で受け取れなかったアイコンを、PwVault が各サイト（例: example.com）に直接取りに行きます。問い合わせ先はそのサイト自身だけで、クッキーは送りません。オフにすると PwVault は一切通信しません。取得したアイコンは保管庫の鍵で暗号化して保存します。" />
                            </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- セキュリティ -->
            <StackPanel Spacing="16" IsVisible="{Binding IsSecurity}">
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="h2" Text="マスターパスワードの変更" />
                        <StackPanel>
                            <TextBlock Classes="label" Text="現在のマスターパスワード" />
                            <TextBox PasswordChar="●" Text="{Binding CurrentPassword}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Classes="label" Text="新しいマスターパスワード（12 文字以上）" />
                            <TextBox PasswordChar="●" Text="{Binding NewPassword}" />
                            <ProgressBar Classes="strength" Margin="0,6,0,0" Value="{Binding NewStrengthValue}" />
                            <TextBlock Classes="muted" FontSize="12" Text="{Binding NewStrengthText}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Classes="label" Text="新しいマスターパスワード（確認）" />
                            <TextBox PasswordChar="●" Text="{Binding ConfirmNewPassword}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Classes="accent" Content="変更" IsEnabled="{Binding !PasswordBusy}" Command="{Binding ChangePasswordCommand}" />
                            <ProgressBar IsIndeterminate="True" Width="60" IsVisible="{Binding PasswordBusy}" />
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" Text="{Binding PasswordStatus}" />
                    </StackPanel>
                </Border>
                <Border Classes="card" IsVisible="{Binding QuickUnlockSupported}" local:Tour.Id="settings-hello">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="h2" Text="{Binding QuickUnlockName, StringFormat='{}{0} でアンロック'}" />
                        <TextBlock Classes="muted" FontSize="13"
                                   Text="マスターパスワードの代わりに、顔認証・指紋・PIN でアンロックできます。鍵は Windows が守る取り出せない場所（TPM など）に置かれ、登録はこの PC だけに保存されます。保管庫ファイルを盗まれても、この登録は使えません。" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock VerticalAlignment="Center" Text="状態:" />
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="有効" IsVisible="{Binding QuickUnlockEnabled}" />
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="無効" IsVisible="{Binding !QuickUnlockEnabled}" />
                        </StackPanel>
                        <StackPanel IsVisible="{Binding !QuickUnlockEnabled}" Spacing="6">
                            <TextBlock Classes="label" Text="有効にするには、確認のためマスターパスワードを入力" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox PasswordChar="●" Text="{Binding QuickUnlockPassword}" />
                                <Button Grid.Column="1" Classes="accent" Content="有効にする" IsEnabled="{Binding !QuickUnlockBusy}"
                                        Command="{Binding EnableQuickUnlockCommand}" />
                            </Grid>
                        </StackPanel>
                        <Button Content="無効にする" IsVisible="{Binding QuickUnlockEnabled}" Command="{Binding DisableQuickUnlockCommand}" />
                        <Grid ColumnDefinitions="Auto,120" ColumnSpacing="12">
                            <TextBlock VerticalAlignment="Center" Text="マスターパスワードの入力を求める間隔（日）" />
                            <NumericUpDown Grid.Column="1" Minimum="1" Maximum="90" Increment="1" FormatString="0" Value="{Binding QuickUnlockDays}" />
                        </Grid>
                        <TextBlock Classes="muted" FontSize="12"
                                   Text="忘れないよう、この日数ごとにマスターパスワードでのアンロックが必要になります。マスターパスワードを変えたときは登録が解除されます。" />
                        <TextBlock TextWrapping="Wrap" Text="{Binding QuickUnlockStatus}" />
                    </StackPanel>
                </Border>
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="h2" Text="鍵導出（Argon2id）のコスト" />
                        <TextBlock Classes="muted" FontSize="12"
                                   Text="値を大きくすると、保管庫ファイルが盗まれたときの総当たりが遅くなりますが、アンロックにも時間がかかります。目安はアンロック 0.5〜1 秒です。" />
                        <TextBlock Text="{Binding KdfCurrent}" />
                        <Grid ColumnDefinitions="260,160" RowDefinitions="Auto,Auto" RowSpacing="10">
                            <TextBlock VerticalAlignment="Center" Text="メモリ量（MiB）" />
                            <NumericUpDown Grid.Column="1" Minimum="{Binding MinMemoryMiB}" Maximum="{Binding MaxMemory}" Increment="16" FormatString="0" Value="{Binding MemoryMiB}" />
                            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="反復回数" />
                            <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="{Binding MinIterations}" Maximum="{Binding MaxIter}" Increment="1" FormatString="0" Value="{Binding Iterations}" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="所要時間を計測" IsEnabled="{Binding !KdfBusy}" Command="{Binding MeasureKdfCommand}" />
                            <Button Content="この PC に合わせて推奨値を計算" IsEnabled="{Binding !KdfBusy}" Command="{Binding RecommendKdfCommand}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Classes="label" Text="適用にはマスターパスワードが必要です" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox PasswordChar="●" Text="{Binding KdfPassword}" />
                                <Button Grid.Column="1" Classes="accent" Content="適用" IsEnabled="{Binding !KdfBusy}" Command="{Binding ApplyKdfCommand}" />
                            </Grid>
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" Text="{Binding KdfStatus}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 保存先と同期 -->
            <StackPanel Spacing="16" IsVisible="{Binding IsStorage}" local:Tour.Id="settings-storage">
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="h2" Text="保存先（ほかの PC と共有）" />
                        <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap"
                                   Text="Google ドライブ（パソコン版）や Nextcloud のアプリが PC 上に作る同期フォルダに保管庫を置くと、ほかの PC でも同じ保管庫を使えます。アップロードはそれらのアプリが行い、PwVault 自体は通信しません。クラウドに置かれるのは暗号化済みのファイルだけです。" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock VerticalAlignment="Center" Text="現在:" />
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding CurrentStorage}" />
                        </StackPanel>
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                            <Button Content="この PC に移す" MinWidth="200" IsEnabled="{Binding !StorageBusy}" Command="{Binding MoveToLocalCommand}" />
                            <TextBlock Grid.Column="1" Classes="muted" FontSize="12" VerticalAlignment="Center" Text="ドキュメントの PwVault フォルダ" />
                            <Button Grid.Row="1" Content="Google ドライブに移す" MinWidth="200" IsEnabled="{Binding CanMoveToGoogleDrive}" Command="{Binding MoveToGoogleDriveCommand}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Classes="muted" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding GoogleDriveText}" />
                            <Button Grid.Row="2" Content="Nextcloud に移す" MinWidth="200" IsEnabled="{Binding CanMoveToNextcloud}" Command="{Binding MoveToNextcloudCommand}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Classes="muted" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding NextcloudText}" />
                            <Button Grid.Row="3" Content="その他の場所へ…" MinWidth="200" IsEnabled="{Binding !StorageBusy}" Command="{Binding MoveToOtherCommand}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Classes="muted" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Text="OneDrive・Dropbox などの同期フォルダも選べます" />
                        </Grid>
                        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                                   Text="複数の PC で同時に使っても、変更はエントリごとに自動で合体します（同じエントリを両方で変えたときは新しい方を残し、もう一方のパスワードは履歴に残します）。2 台目の PC では、最初の画面で同期フォルダの保管庫を開いてください。" />
                        <TextBlock TextWrapping="Wrap" Text="{Binding StorageStatus}"
                                   IsVisible="{Binding StorageStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                </Border>

                <!-- マスターパスワードが変わる前に退避した変更（自動では取り込めないもの） -->
                <Border Classes="card" IsVisible="{Binding HasRescueFiles}">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="h2" Text="前のマスターパスワードで保存された変更" />
                        <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap"
                                   Text="この PC で「保存できなかった変更」として退避したファイルが、マスターパスワードの変更（保管庫の鍵の作り直し）の前のものだったため、自動では取り込めませんでした。退避したとき（変更する前）のマスターパスワードを入れると取り込めます。" />
                        <SelectableTextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding RescueFilesText}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox Width="280" PasswordChar="●" PlaceholderText="変更する前のマスターパスワード" Text="{Binding RescuePassword}" />
                            <Button Classes="accent" Content="取り込む" Command="{Binding ImportRescuesCommand}" />
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" Text="{Binding RescueStatus}"
                                   IsVisible="{Binding RescueStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ブラウザ連携 -->
            <StackPanel Spacing="16" IsVisible="{Binding IsBrowser}" local:Tour.Id="settings-browser">
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="h2" Text="ブラウザ連携（右クリックで自動入力）" />
                        <TextBlock Classes="muted" FontSize="13"
                                   Text="Chrome・Edge・Firefox の入力欄を右クリックすると「PwVault」メニューに表示中のサイトのエントリが並び、選ぶとユーザーIDとパスワードを入力します。PwVault がアンロックされている間だけ使えます。通信は PC 内だけで行います。" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock VerticalAlignment="Center" Text="状態:" />
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding BrowserStatus}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Classes="accent" Content="有効にする" IsVisible="{Binding !BrowserEnabled}"
                                    IsEnabled="{Binding BrowserSupported}" Command="{Binding EnableBrowserCommand}" />
                            <Button Content="無効にする" IsVisible="{Binding BrowserEnabled}" Command="{Binding DisableBrowserCommand}" />
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" Text="{Binding BrowserMessage}"
                                   IsVisible="{Binding BrowserMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    
                        <StackPanel Spacing="10" IsVisible="{Binding BrowserEnabled}">
                            <Border Background="{DynamicResource PaneBackground}" CornerRadius="6" Padding="12">
                                <StackPanel Spacing="6">
                                    <TextBlock FontWeight="SemiBold" Text="Chrome / Edge に拡張機能を入れる" />
                                    <TextBlock Classes="muted" FontSize="13" Text="1. アドレスバーに chrome://extensions（Edge は edge://extensions）と入力して開く&#x0a;2. 「デベロッパー モード」をオンにする&#x0a;3. 「パッケージ化されていない拡張機能を読み込む」で、次のフォルダを選ぶ" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <SelectableTextBlock FontSize="12" VerticalAlignment="Center" Text="{Binding ChromiumExtensionDir}" TextWrapping="Wrap" />
                                        <Button Grid.Column="1" Content="フォルダを開く" Command="{Binding OpenChromiumFolderCommand}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource PaneBackground}" CornerRadius="6" Padding="12">
                                <StackPanel Spacing="6">
                                    <TextBlock FontWeight="SemiBold" Text="Firefox に拡張機能を入れる" />
                                    <TextBlock Classes="muted" FontSize="13" Text="1. アドレスバーに about:debugging#/runtime/this-firefox と入力して開く&#x0a;2. 「一時的なアドオンを読み込む」で、次のフォルダの manifest.json を選ぶ&#x0a;※ 署名していないため、Firefox を再起動すると外れます（毎回読み込み直しが必要）" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <SelectableTextBlock FontSize="12" VerticalAlignment="Center" Text="{Binding FirefoxExtensionDir}" TextWrapping="Wrap" />
                                        <Button Grid.Column="1" Content="フォルダを開く" Command="{Binding OpenFirefoxFolderCommand}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- アプリへの自動入力 -->
            <StackPanel Spacing="16" IsVisible="{Binding IsAutoType}" local:Tour.Id="settings-autotype">
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="h2" Text="ゲーム・アプリのログイン画面に入力" />
                        <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap"
                                   Text="FF14 のランチャーなど、ブラウザ以外のログイン画面で ID 欄をクリックしてからショートカットキーを押すと、エントリを選ぶ小さな窓が出ます。選ぶと、ID → Tab → パスワードの順にキーボードで打ったのと同じ形で入力します（Enter は押しません）。" />
                        <CheckBox IsChecked="{Binding AutoTypeEnabled}" IsEnabled="{Binding AutoTypeSupported}" Content="ショートカットキーで自動入力する" />
                        <Grid ColumnDefinitions="Auto,220" ColumnSpacing="12" IsEnabled="{Binding AutoTypeSupported}">
                            <TextBlock VerticalAlignment="Center" Text="ショートカットキー" />
                            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding HotKeys}" SelectedItem="{Binding SelectedHotKey}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="svc:AutoTypeHotKey">
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <TextBlock TextWrapping="Wrap" Text="{Binding AutoTypeStatus}" />
                        <Separator />
                        <StackPanel Spacing="6" IsEnabled="{Binding AutoTypeSupported}">
                            <CheckBox IsChecked="{Binding AutoTypeOnOpenEnabled}" Content="紐付けたアプリの画面が前に出たら、エントリの設定に合わせて動く" />
                            <TextBlock Classes="muted" FontSize="12" Margin="28,0,0,0" TextWrapping="Wrap"
                                       Text="エントリの編集画面の「このアプリが前に出たとき」で、「候補を出す」（Enter で入力）か「数秒後に自動で入力する」を選べます。同じ画面では 1 回だけ動きます。PwVault がアンロック中のときだけ働きます。" />
                            <Grid ColumnDefinitions="Auto,120" ColumnSpacing="12" Margin="28,4,0,0">
                                <TextBlock VerticalAlignment="Center" Text="自動で入力するまでの秒数" />
                                <NumericUpDown Grid.Column="1" Minimum="1" Maximum="15" Increment="1" FormatString="0" Value="{Binding AutoTypeOnOpenSeconds}" />
                            </Grid>
                        </StackPanel>
                        <Border Background="{DynamicResource PaneBackground}" CornerRadius="6" Padding="12">
                            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                                       Text="・間違った画面に入力しないよう、エントリに「使うアプリ」を紐付けます。紐付けていないアプリに入力するときは確認が出ます（その場で紐付けもできます）。紐付けはエントリの編集画面でも変えられます。&#x0a;・打ち込む直前に、前面の画面が入力先のままか確かめ、変わっていたら入力を止めます。&#x0a;・ゲームによっては、自動で打ち込まれた文字を受け付けないことがあります。管理者として動いているアプリには入力できません。" />
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 更新 -->
            <StackPanel Spacing="16" IsVisible="{Binding IsUpdate}">
                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="h2" Text="更新" />
                        <TextBlock Text="{Binding Main.CurrentVersion, StringFormat='現在の版: v{0}'}" />
                        <StackPanel>
                            <CheckBox IsChecked="{Binding CheckForUpdates}" Content="新しい版を自動で確認する（起動時と 1 日 1 回）" />
                            <TextBlock Classes="muted" FontSize="12" Margin="28,0,0,0"
                                       Text="GitHub の最新リリースだけを確認します。更新ファイルは、アプリに埋め込んだ公開鍵で署名を確かめてから入れ替えます。" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="今すぐ確認" Command="{Binding Main.CheckForUpdatesNowCommand}" />
                            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Main.UpdateStatus}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 使い方 -->
            <StackPanel Spacing="16" IsVisible="{Binding IsHelp}">
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="h2" Text="チュートリアル" />
                        <TextBlock Classes="muted" FontSize="13"
                                   Text="PwVault の基本（エントリの追加・検索・コピー、ブラウザでの自動入力、ほかの PC との共有、Windows Hello など）を順番に紹介します。約 2 分です。" />
                        <Button Classes="accent" Content="▶ チュートリアルを見る" Command="{Binding Main.StartTutorialCommand}" />
                    </StackPanel>
                </Border>
                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="h2" Text="PwVault について" />
                        <TextBlock Text="{Binding Main.CurrentVersion, StringFormat='版: v{0}'}" />
                        <TextBlock Classes="muted" FontSize="13"
                                   Text="パスワードを暗号化して、この PC 上の 1 つのファイルに保存するパスワード管理アプリです。ソースコードと詳しい説明は GitHub で公開しています（GPL-3.0）。" />
                        <Button Content="GitHub の説明ページを開く" Command="{Binding OpenProjectPageCommand}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>