<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PwVault.App.ViewModels"
        x:Class="PwVault.App.Views.AutoTypePickerWindow"
        x:DataType="vm:AutoTypePickerViewModel"
        Title="PwVault 自動入力"
        Icon="/Assets/avalonia-logo.ico"
        Width="480" Height="500" CanResize="False"
        WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="False"
        Background="{DynamicResource PaneBackground}">
    <Window.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
    </Window.KeyBindings>

    <Panel>
        <DockPanel Margin="16">
            <StackPanel DockPanel.Dock="Top" Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Image Source="/Assets/avalonia-logo.ico" Width="20" Height="20" />
                    <TextBlock Classes="h2" Text="自動入力" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding TargetText, StringFormat='入力先: {0}'}" />
                <TextBlock Classes="success" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding OpenedAutomatically}"
                           Text="紐付けたアプリが開いたので候補を出しました。ID 欄にカーソルがあることを確かめて Enter で入力します。" />
                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                           IsVisible="{Binding LinkedCount, Converter={x:Static vm:AutoTypePickerViewModel.MoreThanOne}}"
                           Text="このアプリ用のアカウントが複数あります。番号のキー（1〜9）を押すと、そのアカウントですぐに入力します。" />
                <TextBox x:Name="SearchBox" PlaceholderText="エントリを検索" Text="{Binding SearchText}">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding ChooseCommand}" />
                        <KeyBinding Gesture="Shift+Enter" Command="{Binding ChooseTotpCommand}" />
                        <KeyBinding Gesture="Down" Command="{Binding MoveSelectionCommand}" CommandParameter="1" />
                        <KeyBinding Gesture="Up" Command="{Binding MoveSelectionCommand}" CommandParameter="-1" />
                    </TextBox.KeyBindings>
                </TextBox>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,10,0,0">
                <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding Error}"
                           IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                           Text="ID → Tab → パスワードの順に入力します（Enter は押しません）" />
                <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap" IsVisible="{Binding CanTypeTotp}"
                           Text="Shift + Enter でワンタイムパスワードだけを入力します（2 段階認証の欄にカーソルを置いてから）" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="この画面では出さない" IsVisible="{Binding CanIgnoreThisWindow}" Command="{Binding IgnoreThisWindowCommand}"
                            ToolTip.Tip="更新の画面など、ログイン画面ではない画面で候補が出たときに押すと、次からこの画面では出しません" />
                    <Button Content="キャンセル" Command="{Binding CancelCommand}" />
                    <Button Content="🔢 ワンタイムだけ" IsVisible="{Binding CanTypeTotp}" Command="{Binding ChooseTotpCommand}"
                            ToolTip.Tip="ワンタイムパスワード（2 段階認証の番号）だけを入力します（Shift + Enter）" />
                    <Button Classes="accent" Content="入力" Command="{Binding ChooseCommand}" />
                </StackPanel>
            </StackPanel>

            <Border Classes="card" Padding="4" Margin="0,10,0,0">
                <Panel>
                    <TextBlock Classes="muted" Margin="12" TextWrapping="Wrap" IsVisible="{Binding !Items.Count}"
                               Text="見つかりません。" />
                    <ListBox x:Name="List" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                             Background="Transparent" DoubleTapped="OnDoubleTapped">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:AutoTypeItem">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                    <!-- 数字キーで選べる番号（このアプリ用のアカウントだけ） -->
                                    <Border Width="22" Height="22" CornerRadius="11" VerticalAlignment="Center"
                                            BorderBrush="{DynamicResource SystemAccentColor}" BorderThickness="1.5"
                                            IsVisible="{Binding HasNumber}">
                                        <TextBlock Text="{Binding NumberText}" FontWeight="SemiBold" FontSize="12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Classes="muted" FontSize="12" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="🔢" FontSize="13" VerticalAlignment="Center" IsVisible="{Binding HasTotp}"
                                                   ToolTip.Tip="ワンタイムパスワードあり" />
                                        <Border IsVisible="{Binding IsLinked}" Background="{DynamicResource SystemAccentColor}"
                                                CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="このアプリ用" FontSize="11" Foreground="White" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Panel>
            </Border>
        </DockPanel>

        <!-- 紐付けていないエントリを選んだときの確認 -->
        <Panel IsVisible="{Binding Confirming, Converter={x:Static ObjectConverters.IsNotNull}}"
               Background="{DynamicResource OverlayBackground}">
            <Border Classes="card" Margin="20" VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <TextBlock Classes="h2" Text="このアプリに入力しますか？" />
                    <TextBlock TextWrapping="Wrap" Text="{Binding ConfirmText}" />
                    <StackPanel Spacing="8">
                        <Button Classes="accent" HorizontalAlignment="Stretch" Content="紐付けて入力（おすすめ）" Command="{Binding LinkAndTypeCommand}" />
                        <Button HorizontalAlignment="Stretch" Content="今回だけ入力" Command="{Binding TypeOnceCommand}" />
                        <Button HorizontalAlignment="Stretch" Content="やめる" Command="{Binding CancelConfirmCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Panel>
    </Panel>
</Window>
