<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PwVault.App.Views.AppTitle">
    <!-- 左上のアプリ名。アイコンは実行ファイル・通知領域と同じもの -->
    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsHitTestVisible="False">
        <Image Source="/Assets/avalonia-logo.ico" Width="22" Height="22" RenderOptions.BitmapInterpolationMode="HighQuality" />
        <TextBlock Text="PwVault" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
    </StackPanel>
</UserControl>
