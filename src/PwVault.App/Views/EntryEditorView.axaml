<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PwVault.App.ViewModels"
             xmlns:svc="using:PwVault.App.Services"
             x:Class="PwVault.App.Views.EntryEditorView"
             x:DataType="vm:EntryEditorViewModel">
    <UserControl.KeyBindings>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
        <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
    </UserControl.KeyBindings>

    <Border Classes="card" Padding="0">
        <DockPanel>
            <Border DockPanel.Dock="Bottom" Padding="24,12" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="error" VerticalAlignment="Center" Text="{Binding Error}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Content="キャンセル" ToolTip.Tip="Esc" Command="{Binding CancelCommand}" />
                        <Button Classes="accent" Content="保存" ToolTip.Tip="{x:Static svc:Shortcuts.Save}" Command="{Binding SaveCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer>
                <StackPanel Spacing="14" Margin="24">
                    <TextBlock Classes="h2" Text="{Binding Heading}" />

                    <StackPanel>
                        <TextBlock Classes="label" Text="タイトル" />
                        <TextBox x:Name="TitleBox" Text="{Binding EntryTitle}" />
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Classes="label" Text="ユーザーID" />
                        <TextBox Text="{Binding Username}" />
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Classes="label" Text="パスワード" />
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                            <TextBox PasswordChar="●" FontFamily="Consolas, monospace"
                                     RevealPassword="{Binding RevealPassword}" Text="{Binding Password}" />
                            <ToggleButton Grid.Column="1" Content="表示" IsChecked="{Binding RevealPassword}" />
                            <Button Grid.Column="2" Content="生成…" Command="{Binding GenerateCommand}" />
                        </Grid>
                        <ProgressBar Classes="strength" Margin="0,6,0,0" Value="{Binding StrengthValue}" />
                        <TextBlock Classes="muted" FontSize="12" Margin="0,2,0,0" Text="{Binding StrengthText}" />
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Classes="label" Text="URL" />
                        <TextBox Text="{Binding Url}" PlaceholderText="https://" />
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Classes="label" Text="タグ（カンマ区切り）" />
                        <TextBox Text="{Binding TagsText}" PlaceholderText="仕事, 銀行" />
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Classes="label" Text="メモ" />
                        <TextBox Text="{Binding Notes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" />
                    </StackPanel>

                    <CheckBox Content="お気に入り" IsChecked="{Binding Favorite}" />

                    <!-- ゲーム・アプリへの自動入力 -->
                    <StackPanel IsVisible="{Binding AutoTypeSupported}" Spacing="4">
                        <TextBlock Classes="label" Text="自動入力するアプリ（ゲームのランチャーなど。実行ファイル名をカンマ区切り）" />
                        <TextBox Text="{Binding AutoTypeAppsText}" PlaceholderText="例: launcher.exe（ログイン画面でショートカットキーを押すと「入力先」に出る名前）" />
                        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                                   Text="ショートカットキーで自動入力するとき、ここに書いたアプリでは確認なしで入力します。入力するときに「紐付けて入力」を選んでも追加されます。&#x0a;複数のアカウントを使う場合は、アカウントごとにエントリを作り、どれにも同じアプリを書いてください（選択窓で番号のキーで選べ、前回使ったアカウントが最初から選ばれます）。" />
                        <CheckBox Content="パスワードだけを入力する（ID は入力しない）" IsChecked="{Binding AutoTypePasswordOnly}" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,4,0,0">
                            <TextBlock VerticalAlignment="Center" Text="このアプリが前に出たとき" />
                            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding OnOpenOptions}" SelectedItem="{Binding SelectedOnOpen}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:EntryEditorViewModel+OnOpenOption">
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                                   Text="「数秒後に自動で入力する」は、画面の隅に残り秒数と「やめる」を出してから、ID 欄にカーソルがある前提で入力します。ランチャーを開いたときにカーソルが ID 欄に来るアプリで使ってください。" />
                        <TextBlock Classes="label" Margin="0,6,0,0" Text="反応しない画面の名前（1 行に 1 つ。題名にこの文字を含む画面では、開いたときの動きをしない）" />
                        <TextBox Text="{Binding AutoTypeIgnoreTitlesText}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54"
                                 PlaceholderText="例: 更新" />
                        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                                   Text="更新の画面などで候補が出たときに「この画面では出さない」を押すと、ここに追加されます。「終了しますか？」のような確認の画面には、最初から反応しません。" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
