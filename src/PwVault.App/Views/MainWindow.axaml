<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PwVault.App.ViewModels"
        xmlns:local="using:PwVault.App.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="720"
        x:Class="PwVault.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="PwVault"
        Width="1100" Height="720" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="{x:Static local:WindowChrome.CaptionButtonsHeight}"
        Background="{DynamicResource PaneBackground}">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+L" Command="{Binding LockCommand}" />
    </Window.KeyBindings>

    <!-- 最大化したとき画面外にはみ出す枠の分だけ内側に寄せる -->
    <Panel Margin="{Binding $parent[Window].OffScreenMargin}">
        <DockPanel>
            <!-- アンロック前の画面の上部の帯（アンロック後は一覧画面のツールバーがこれを兼ねる） -->
            <Border DockPanel.Dock="Top" Classes="titlebar" IsVisible="{Binding !IsUnlocked}">
                <local:AppTitle HorizontalAlignment="Left" />
            </Border>

            <!-- 更新の通知 -->
            <Border DockPanel.Dock="Bottom" IsVisible="{Binding HasUpdate}" Padding="12,8"
                    Background="{DynamicResource SystemAccentColor}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <TextBlock Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Text="{Binding AvailableUpdate.Version, StringFormat='PwVault v{0} が利用できます'}" />
                        <TextBlock Foreground="White" VerticalAlignment="Center" Text="{Binding UpdateStatus}" />
                        <ProgressBar IsVisible="{Binding IsUpdating}" Width="120" Minimum="0" Maximum="1" Value="{Binding UpdateProgress}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <Button Content="更新して再起動" IsEnabled="{Binding !IsUpdating}" Command="{Binding InstallUpdateCommand}" />
                        <Button Content="変更内容" Command="{Binding OpenUpdatePageCommand}" />
                        <Button Content="あとで" IsEnabled="{Binding !IsUpdating}" Command="{Binding DismissUpdateCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl Content="{Binding CurrentPage}" />
        </DockPanel>

        <!-- チュートリアル（ウィンドウ内オーバーレイ） -->
        <Panel IsVisible="{Binding Tutorial, Converter={x:Static ObjectConverters.IsNotNull}}"
               Background="{DynamicResource OverlayBackground}">
            <Border Classes="card" Width="560" HorizontalAlignment="Center" VerticalAlignment="Center"
                    DataContext="{Binding Tutorial}" x:DataType="vm:TutorialViewModel">
                <DockPanel>
                    <ProgressBar DockPanel.Dock="Top" Minimum="0" Maximum="100" Value="{Binding Progress}" Height="4" MinHeight="4" Margin="0,0,0,16" />
                    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto" Margin="0,20,0,0">
                        <Button Content="スキップ" IsCancel="True" Command="{Binding CloseCommand}" IsVisible="{Binding !IsLast}" />
                        <TextBlock Grid.Column="1" Classes="muted" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding ProgressText}" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                            <Button Content="戻る" IsVisible="{Binding !IsFirst}" Command="{Binding BackCommand}" />
                            <Button Classes="accent" Content="{Binding NextText}" IsDefault="True" Command="{Binding NextCommand}" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Spacing="12" MinHeight="240">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="{Binding Current.Icon}" FontSize="30" VerticalAlignment="Center" />
                            <TextBlock Classes="h1" Text="{Binding Current.Title}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Text="{Binding Current.Body}" TextWrapping="Wrap" LineHeight="22" />
                        <Button Content="→ この設定を開く" IsVisible="{Binding CanOpenSettings}" Command="{Binding OpenSettingsCommand}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Panel>

        <!-- 確認ダイアログ（ウィンドウ内オーバーレイ） -->
        <Panel IsVisible="{Binding Confirm, Converter={x:Static ObjectConverters.IsNotNull}}"
               Background="{DynamicResource OverlayBackground}">
            <Border Classes="card" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center"
                    DataContext="{Binding Confirm}" x:DataType="vm:ConfirmRequest">
                <StackPanel Spacing="16">
                    <TextBlock Classes="h2" Text="{Binding Title}" />
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="キャンセル" IsCancel="True"
                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ConfirmCancelCommand}" />
                        <Button Classes="accent" Content="{Binding OkText}" IsDefault="True"
                                Classes.danger="{Binding IsDanger}"
                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ConfirmOkCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Panel>
    </Panel>
</Window>
