<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PwVault.App.ViewModels"
             xmlns:core="using:PwVault.Core"
             xmlns:svc="using:PwVault.App.Services"
             xmlns:local="using:PwVault.App.Views"
             x:Class="PwVault.App.Views.VaultView"
             x:DataType="vm:VaultViewModel">

    <!-- NFR-09 キーボードショートカット -->
    <UserControl.KeyBindings>
        <KeyBinding Gesture="Ctrl+F" Command="{Binding FocusSearchCommand}" />
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewEntryCommand}" />
        <KeyBinding Gesture="Ctrl+E" Command="{Binding EditEntryCommand}" />
        <KeyBinding Gesture="Ctrl+B" Command="{Binding CopyUsernameCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+C" Command="{Binding CopyPasswordCommand}" />
        <KeyBinding Gesture="Ctrl+G" Command="{Binding ShowGeneratorCommand}" />
    </UserControl.KeyBindings>

    <Panel>
        <DockPanel>
            <!-- ツールバー（タイトルバーを兼ねる。何もない所をドラッグするとウィンドウが動く） -->
            <Border DockPanel.Dock="Top" Classes="titlebar">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                    <local:AppTitle />
                    <TextBox Grid.Column="1" x:Name="SearchBox" local:Tour.Id="search" MaxWidth="520" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                             PlaceholderText="{x:Static svc:Shortcuts.SearchPlaceholder}"
                             Text="{Binding SearchText}" IsEnabled="{Binding !HasSubPage}" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button local:Tour.Id="new" Classes="accent" Content="＋ 新規" ToolTip.Tip="{x:Static svc:Shortcuts.NewTip}" Command="{Binding NewEntryCommand}" />
                        <Button local:Tour.Id="generate" Content="生成" ToolTip.Tip="{x:Static svc:Shortcuts.GenerateTip}" Command="{Binding ShowGeneratorCommand}" />
                        <Button local:Tour.Id="import" Content="取込/書出" Command="{Binding ShowImportExportCommand}" />
                        <Button local:Tour.Id="trash" Content="ゴミ箱" Command="{Binding ShowTrashCommand}" />
                        <Button local:Tour.Id="settings" Content="設定" Command="{Binding ShowSettingsCommand}" />
                        <Button local:Tour.Id="lock" Content="🔒 ロック" ToolTip.Tip="{x:Static svc:Shortcuts.LockTip}" Command="{Binding LockCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ステータスバー -->
            <Border DockPanel.Dock="Bottom" Padding="12,3" Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="16">
                    <TextBlock FontSize="12" Classes="muted" VerticalAlignment="Center" Text="{Binding Status}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    <TextBlock Grid.Column="1" FontSize="12" Classes="success" VerticalAlignment="Center" Text="{Binding ClipboardStatus}" TextWrapping="NoWrap" />
                    <TextBlock Grid.Column="2" FontSize="12" Classes="muted" VerticalAlignment="Center" Text="{Binding CountText}" TextWrapping="NoWrap" />
                    <Button Grid.Column="3" local:Tour.Id="theme" Classes="statusbar" Content="{Binding Main.ThemeToggleText}"
                            ToolTip.Tip="ライト / ダークを切り替える（色は「設定」で選べます）" Command="{Binding Main.ToggleThemeCommand}" />
                </Grid>
            </Border>

            <Panel>
                <!-- S7〜S9 -->
                <ContentControl Content="{Binding SubPage}" IsVisible="{Binding HasSubPage}" />

                <!-- S3 一覧 + S4 詳細 / S5 編集 -->
                <Grid ColumnDefinitions="340,*" IsVisible="{Binding !HasSubPage}">
                    <DockPanel Margin="12,12,6,12">
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,*" ColumnSpacing="6" Margin="0,0,0,8">
                            <ComboBox local:Tour.Id="filter" HorizontalAlignment="Stretch" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FilterOption">
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SortOption">
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <Border local:Tour.Id="list" Classes="card" Padding="4">
                            <Panel>
                                <TextBlock Classes="muted" Margin="16" HorizontalAlignment="Center" TextAlignment="Center"
                                           IsVisible="{Binding !Items.Count}"
                                           Text="エントリがありません。&#x0a;「＋ 新規」または「取込/書出」から追加できます。" />
                                <ListBox x:Name="EntryList" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                                         Background="Transparent" DoubleTapped="OnEntryDoubleTapped">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:EntryItemViewModel">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                <Panel Width="32" Height="32">
                                                    <!-- サイトのアイコン。無ければ頭文字の丸 -->
                                                    <Border CornerRadius="16" Background="{DynamicResource AvatarBackground}" IsVisible="{Binding !HasIcon}">
                                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AvatarForeground}" Text="{Binding Initial}" />
                                                    </Border>
                                                    <Border CornerRadius="6" ClipToBounds="True" Background="{DynamicResource CardBackground}" IsVisible="{Binding HasIcon}">
                                                        <Image Source="{Binding Icon}" Width="24" Height="24" Stretch="Uniform"
                                                               RenderOptions.BitmapInterpolationMode="HighQuality" />
                                                    </Border>
                                                </Panel>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Classes="muted" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <TextBlock Text="⚠" Classes="warning" IsVisible="{Binding HasWarning}" ToolTip.Tip="{Binding WarningText}" />
                                                    <TextBlock Text="★" Classes="warning" IsVisible="{Binding IsFavorite}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Panel>
                        </Border>
                    </DockPanel>

                    <Panel Grid.Column="1" Margin="6,12,12,12">
                        <!-- 編集 -->
                        <ContentControl Content="{Binding Editor}" IsVisible="{Binding IsEditing}" />

                        <!-- 未選択 -->
                        <Border Classes="card">
                            <Border.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="!HasSelection" />
                                    <Binding Path="!IsEditing" />
                                </MultiBinding>
                            </Border.IsVisible>
                            <TextBlock Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                       Text="{x:Static svc:Shortcuts.EmptyDetailHint}" />
                        </Border>

                        <!-- S4 詳細 -->
                        <Border Classes="card" Padding="0">
                            <Border.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="HasSelection" />
                                    <Binding Path="!IsEditing" />
                                </MultiBinding>
                            </Border.IsVisible>
                            <ScrollViewer>
                                <StackPanel Spacing="18" Margin="24">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBlock Classes="h1" Text="{Binding SelectedItem.Title}" TextWrapping="Wrap" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                                            <ToggleButton Classes="icon" Content="★" ToolTip.Tip="お気に入り"
                                                          IsChecked="{Binding SelectedItem.IsFavorite, Mode=OneWay}"
                                                          Command="{Binding ToggleFavoriteCommand}" />
                                            <Button Content="編集" ToolTip.Tip="{x:Static svc:Shortcuts.Edit}" Command="{Binding EditEntryCommand}" />
                                            <Button Classes="danger" Content="ゴミ箱へ" Command="{Binding TrashEntryCommand}" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Classes="warning" IsVisible="{Binding SelectedItem.HasWarning}"
                                               Text="{Binding SelectedItem.WarningText, StringFormat='⚠ {0}。パスワードの変更をおすすめします。'}" />

                                    <StackPanel>
                                        <TextBlock Classes="label" Text="ユーザーID" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                            <TextBox IsReadOnly="True" Text="{Binding SelectedItem.Entry.Data.Username}" />
                                            <Button Grid.Column="1" Content="コピー" ToolTip.Tip="{x:Static svc:Shortcuts.CopyUser}" Command="{Binding CopyUsernameCommand}" />
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel>
                                        <TextBlock Classes="label" Text="パスワード" />
                                        <Grid local:Tour.Id="detail-password" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                            <TextBox IsReadOnly="True" PasswordChar="●" FontFamily="Consolas, monospace"
                                                     RevealPassword="{Binding RevealPassword}"
                                                     Text="{Binding SelectedItem.Entry.Data.Password}" />
                                            <ToggleButton Grid.Column="1" Content="表示" IsChecked="{Binding RevealPassword}" />
                                            <Button Grid.Column="2" Content="コピー" ToolTip.Tip="{x:Static svc:Shortcuts.CopyPassword}" Command="{Binding CopyPasswordCommand}" />
                                        </Grid>
                                    </StackPanel>

                                    <!-- ワンタイムパスワード -->
                                    <StackPanel IsVisible="{Binding HasTotp}">
                                        <TextBlock Classes="label" Text="ワンタイムパスワード" />
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <SelectableTextBlock FontFamily="Consolas, monospace" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center"
                                                                 Text="{Binding TotpCode}" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" MaxWidth="160" HorizontalAlignment="Left">
                                                <ProgressBar Minimum="0" Maximum="{Binding TotpPeriod}" Value="{Binding TotpRemaining}" MinWidth="80" />
                                                <TextBlock Classes="muted" FontSize="12" Text="{Binding TotpRemainingText}" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="コピー" VerticalAlignment="Center" Command="{Binding CopyTotpCommand}" />
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel>
                                        <TextBlock Classes="label" Text="URL" />
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                            <TextBox IsReadOnly="True" Text="{Binding SelectedItem.Entry.Data.Url}" />
                                            <Button Grid.Column="1" Content="開く" IsEnabled="{Binding SelectedItem.HasUrl}" Command="{Binding OpenUrlCommand}" />
                                            <Button Grid.Column="2" Content="コピー" Command="{Binding CopyUrlCommand}" />
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel>
                                        <TextBlock Classes="label" Text="タグ" />
                                        <TextBlock Text="{Binding SelectedItem.TagsText}" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel>
                                        <TextBlock Classes="label" Text="メモ" />
                                        <SelectableTextBlock Text="{Binding SelectedItem.Entry.Data.Notes}" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Spacing="24">
                                        <TextBlock Classes="muted" FontSize="12" Text="{Binding SelectedItem.CreatedText, StringFormat='作成: {0}'}" />
                                        <TextBlock Classes="muted" FontSize="12" Text="{Binding SelectedItem.UpdatedText, StringFormat='更新: {0}'}" />
                                    </StackPanel>

                                    <!-- FR-15 パスワード変更履歴 -->
                                    <Expander Header="パスワード変更履歴" IsVisible="{Binding SelectedItem.HasHistory}" HorizontalAlignment="Stretch">
                                        <ItemsControl ItemsSource="{Binding SelectedItem.Entry.Data.History}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="core:PasswordHistoryItem">
                                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                        <TextBlock VerticalAlignment="Center" FontSize="12"
                                                                   Text="{Binding ChangedAt, StringFormat='{}{0:yyyy/MM/dd HH:mm} まで使用'}" />
                                                        <Button Grid.Column="1" Content="コピー"
                                                                Command="{Binding $parent[UserControl].((vm:VaultViewModel)DataContext).CopyHistoryCommand}"
                                                                CommandParameter="{Binding}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Panel>
                </Grid>
            </Panel>
        </DockPanel>

        <!-- S6 パスワード生成（オーバーレイ） -->
        <Panel IsVisible="{Binding Generator, Converter={x:Static ObjectConverters.IsNotNull}}"
               Background="{DynamicResource OverlayBackground}">
            <ContentControl Content="{Binding Generator}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Panel>

        <!-- QR コードの読み取り（オーバーレイ） -->
        <Panel IsVisible="{Binding QrScan, Converter={x:Static ObjectConverters.IsNotNull}}"
               Background="{DynamicResource OverlayBackground}">
            <ContentControl Content="{Binding QrScan}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Panel>
    </Panel>
</UserControl>
